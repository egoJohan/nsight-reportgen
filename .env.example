# Copy to .env and fill in. .env is gitignored; this file is not, so it never
# holds a real value.

# ── DataHive ───────────────────────────────────────────────────────────────
# The service credential. Read-write across the tenant — nSight narrows per
# user itself. The backend refuses to boot without it.
NSIGHT_DATAHIVE_TOKEN=

# Verified email addresses, comma-separated. Whoever signs in first with one of
# these becomes admin, on an EMPTY hive only. Without it a fresh instance has no
# way in at all, because every route is grant-gated.
NSIGHT_BOOTSTRAP_ADMINS=

# ── The report-title writer (egoHive) ──────────────────────────────────────
# Optional. Without it the app runs and every slide keeps whatever title the
# author typed; the generated ones simply never arrive. Both BASE_URL and
# ENDPOINT_ID must be set for the environment to be used at all — otherwise the
# backend looks for a credentials file (EGOHIVE_CREDS_PATH, default
# work/egohive_creds.json), which is not inside the container unless you mount
# it.
# NOTE: this is read INSIDE the backend container, where 127.0.0.1 is the
# container itself. An egoHive running on your own machine is reachable as
# host.docker.internal (compose maps it), e.g. http://host.docker.internal:8000.
EGOHIVE_BASE_URL=
EGOHIVE_ENDPOINT_ID=
EGOHIVE_ENDPOINT_KEY=
EGOHIVE_AGENT_ID=
EGOHIVE_AUTH_SCHEME=bearer
EGOHIVE_MODEL=
EGOHIVE_EMAIL=
EGOHIVE_PASSWORD=

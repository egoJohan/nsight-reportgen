# nSight report-tool backend: FastAPI + the deterministic render engine.
# Needs LibreOffice (pptx -> pdf) and poppler (pdf -> png) for chart rendering.
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim

# Rendering toolchain + fonts (deterministic label metrics).
#
# fonts-inter is the shipped default template's typeface. The .pptx
# embeds it as .fntdata, which LibreOffice does not read, so without the
# system font every deck on the house template renders in a substitute
# and looks nothing like the design.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libreoffice-impress \
        poppler-utils \
        fonts-dejavu \
        fonts-liberation \
        fonts-inter \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies + the project (cached unless deps/source change).
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --no-dev

# Bind to all interfaces for the container network.
#
# NSIGHT_DEMO=1 and NSIGHT_DEMO_DIR used to select a self-contained on-disk
# store that needed no datahive. That mode was removed; the variables stayed,
# saying the image runs against a local JSON store when it does not, and
# server.py refuses to start without a hive regardless. Configuration that
# describes something the code no longer has is worse than none.
ENV NSIGHT_HOST=0.0.0.0 \
    NSIGHT_PORT=8200

EXPOSE 8200
CMD ["/app/.venv/bin/python", "-m", "reportbuilder.api.server"]
